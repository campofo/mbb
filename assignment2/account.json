  "groups": [
    {
      "name": "Administrators",
      "policies": [
        "AdministratorAccess"
      ],
      "inline_policies": {}
    },
    {
      "name": "DevOps",
      "policies": [
        "DevOpsDeploy",
        "EC2Operator",
        "CloudWatchReadOnly"
      ],
      "inline_policies": {}
    },
    {
      "name": "Analysts",
      "policies": [
        "AnalystReadOnly",
        "SelfManageCredentials"
      ],
      "inline_policies": {}
    },
    {
      "name": "Contractors",
      "policies": [
        "ContractorBaseline"
      ],
      "inline_policies": {}
    }
  ],
  "roles": [
    {
      "name": "OrgAdminRole",
      "policies": [
        "AdministratorAccess"
      ],
      "inline_policies": {},
      "trust_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::123456789012:user/judy"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      }
    },
    {
      "name": "InfraAdminRole",
      "policies": [
        "AdministratorAccess"
      ],
      "inline_policies": {},
      "trust_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "ec2.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      }
    },
    {
      "name": "ReportingLambdaRole",
      "policies": [
        "AdministratorAccess"
      ],
      "inline_policies": {},
      "trust_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "lambda.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      }
    },
    {
      "name": "LegacyBatchRole",
      "policies": [
        "AdministratorAccess"
      ],
      "inline_policies": {},
      "trust_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "batch.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      }
    },
    {
      "name": "BreakGlassAdminRole",
      "policies": [
        "AdministratorAccess"
      ],
      "inline_policies": {},
      "trust_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::123456789012:user/dave"
            },
            "Action": "sts:AssumeRole",
            "Condition": {
              "Bool": {
                "aws:MultiFactorAuthPresent": "true"
              }
            }
          }
        ]
      }
    },
    {
      "name": "SuperAdminRole",
      "policies": [
        "AdministratorAccess"
      ],
      "inline_policies": {},
      "trust_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "cloudformation.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      }
    },
    {
      "name": "PublicReadRole",
      "policies": [],
      "inline_policies": {
        "readPublic": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "s3:GetObject",
              "Resource": "arn:aws:s3:::northwind-public/*"
            }
          ]
        }
      },
      "trust_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": "*",
            "Action": "sts:AssumeRole"
          }
        ]
      }
    }
  ],
  "managed_policies": {
    "AdministratorAccess": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "*",
          "Resource": "*"
        }
      ]
    },
    "AnalystReadOnly": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "s3:Get*",
            "s3:List*"
          ],
          "Resource": [
            "arn:aws:s3:::northwind-datalake",
            "arn:aws:s3:::northwind-datalake/*"
          ]
        },
        {
          "Effect": "Allow",
          "Action": "s3:*",
          "Resource": [
            "arn:aws:s3:::northwind-public",
            "arn:aws:s3:::northwind-public/*"
          ]
        }
      ]
    },
    "DevOpsDeploy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "iam:PassRole",
          "Resource": "arn:aws:iam::123456789012:role/InfraAdminRole"
        },
        {
          "Effect": "Allow",
          "Action": [
            "ec2:RunInstances",
            "ec2:Describe*",
            "ec2:StartInstances",
            "ec2:StopInstances"
          ],
          "Resource": "*"
        }
      ]
    },
    "DataLakeFullAccess": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "s3:*",
          "Resource": [
            "arn:aws:s3:::northwind-datalake",
            "arn:aws:s3:::northwind-datalake/*"
          ]
        }
      ]
    },
    "LambdaInvokeOnly": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "lambda:InvokeFunction",
          "Resource": "arn:aws:lambda:us-east-1:123456789012:function:*"
        }
      ]
    },
    "BillingReadOnly": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "aws-portal:View*",
            "ce:Get*",
            "cur:Describe*"
          ],
          "Resource": "*"
        }
      ]
    },
    "SelfManageCredentials": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "iam:ChangePassword",
            "iam:GetUser",
            "iam:CreateAccessKey",
            "iam:ListAccessKeys"
          ],
          "Resource": "arn:aws:iam::123456789012:user/${aws:username}"
        }
      ]
    },
    "ContractorBaseline": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "s3:GetObject",
            "s3:ListBucket"
          ],
          "Resource": [
            "arn:aws:s3:::northwind-reports",
            "arn:aws:s3:::northwind-reports/*",
            "arn:aws:s3:::northwind-pii",
            "arn:aws:s3:::northwind-pii/*"
          ]
        }
      ]
    },
    "EC2Operator": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "ec2:*",
          "Resource": "arn:aws:ec2:us-east-1:123456789012:instance/*"
        }
      ]
    },
    "CloudWatchReadOnly": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "cloudwatch:Get*",
            "cloudwatch:List*",
            "logs:Describe*",
            "logs:Get*"
          ],
          "Resource": "*"
        }
      ]
    },
    "SupportAccess": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "support:*",
          "Resource": "*"
        }
      ]
    },
    "SecretsReader": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "secretsmanager:GetSecretValue",
          "Resource": "arn:aws:secretsmanager:us-east-1:123456789012:secret:*"
        }
      ]
    },
    "NetworkAdmin": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "ec2:*SecurityGroup*",
            "ec2:*Vpc*",
            "ec2:*Subnet*",
            "ec2:Describe*"
          ],
          "Resource": "*"
        }
      ]
    },
    "KMSUser": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "kms:Decrypt",
            "kms:Encrypt",
            "kms:GenerateDataKey"
          ],
          "Resource": "arn:aws:kms:us-east-1:123456789012:key/*"
        }
      ]
    },
    "RemoteReadOnly": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "s3:GetObject",
          "Resource": "arn:aws:s3:::northwind-datalake/*",
          "Condition": {
            "IpAddress": {
              "aws:SourceIp": "203.0.113.0/24"
            }
          }
        },
        {
          "Effect": "Allow",
          "Action": "s3:GetObject",
          "Resource": "arn:aws:s3:::northwind-eu/*",
          "Condition": {
            "StringEquals": {
              "aws:RequestedRegion": "eu-west-1"
            }
          }
        }
      ]
    }
  }
}
