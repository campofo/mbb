{
  "_comment": "A3 requirements for distribute/account.json. PUBLIC: students use this to check their account_fixed.json. designated_admins are the ONLY identities permitted to remain admin-equivalent after your fix. Every must_allow request must still be ALLOW; every must_deny request must become DENY; and no non-admin identity may have Action \"*\" or \"<service>:*\" on Resource \"*\".",
  "designated_admins": [
    "arn:aws:iam::123456789012:user/root_admin",
    "arn:aws:iam::123456789012:role/OrgAdminRole"
  ],
  "must_allow": [
