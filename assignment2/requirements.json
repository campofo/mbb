    {"id": "md3", "principal": "arn:aws:iam::123456789012:user/grace",
     "action": "iam:AddUserToGroup", "resource": "arn:aws:iam::123456789012:group/Administrators"},
    {"id": "md4", "principal": "arn:aws:iam::123456789012:user/judy",
     "action": "sts:AssumeRole", "resource": "arn:aws:iam::123456789012:role/OrgAdminRole"},
    {"id": "md5", "principal": "arn:aws:iam::123456789012:user/dave",
     "action": "iam:UpdateAssumeRolePolicy", "resource": "arn:aws:iam::123456789012:role/LegacyBatchRole"},
    {"id": "md6", "principal": "arn:aws:iam::123456789012:user/bob",
     "action": "s3:DeleteBucket", "resource": "arn:aws:s3:::northwind-datalake"},
    {"id": "md7", "principal": "arn:aws:iam::123456789012:user/erin",
     "action": "lambda:CreateFunction", "resource": "arn:aws:lambda:us-east-1:123456789012:function:evil"},
    {"id": "md8", "principal": "arn:aws:iam::123456789012:user/bob",
