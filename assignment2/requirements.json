    {"id": "ma9", "principal": "arn:aws:iam::123456789012:user/bob",
     "action": "ec2:TerminateInstances", "resource": "arn:aws:ec2:us-east-1:123456789012:instance/i-0abc",
     "context": {"aws:MultiFactorAuthPresent": "true"}}
  ],
  "must_deny": [
    {"id": "md1", "principal": "arn:aws:iam::123456789012:user/erin",
     "action": "s3:GetObject", "resource": "arn:aws:s3:::northwind-pii/customers.csv"},
