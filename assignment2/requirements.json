     "action": "iam:PassRole", "resource": "arn:aws:iam::123456789012:role/InfraAdminRole"},
    {"id": "ma4", "principal": "arn:aws:iam::123456789012:user/dave",
     "action": "s3:GetObject", "resource": "arn:aws:s3:::northwind-datalake/etl/run.log"},
    {"id": "ma5", "principal": "arn:aws:iam::123456789012:user/erin",
     "action": "s3:GetObject", "resource": "arn:aws:s3:::northwind-reports/2026/summary.pdf"},
    {"id": "ma6", "principal": "arn:aws:iam::123456789012:user/erin",
     "action": "lambda:InvokeFunction", "resource": "arn:aws:lambda:us-east-1:123456789012:function:report-builder"},
    {"id": "ma7", "principal": "arn:aws:iam::123456789012:user/grace",
